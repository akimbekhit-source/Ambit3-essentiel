+function parseCardioLog(csv: string): CardioSummary | null {
+  const minutes = new Map<number, { total: number; count: number }>();
+  let total = 0, count = 0, min = Infinity, max = -Infinity;
+  let start = Infinity, end = 0, previous = 0, measuredMs = 0;
+  for (const line of csv.split('\n')) {
+    const [time, value] = line.split(',');
+    const at = Number(time), bpm = Number(value);
+    if (!Number.isSafeInteger(at) || at <= 0 || !Number.isInteger(bpm) || bpm < 20 || bpm > 250) continue;
+    const minute = Math.floor(at / 60000) * 60000;
+    const bucket = minutes.get(minute) ?? { total: 0, count: 0 };
+    bucket.total += bpm;
+    bucket.count++;
+    minutes.set(minute, bucket);
+    total += bpm;
+    count++;
+    min = Math.min(min, bpm);
+    max = Math.max(max, bpm);
+    if (previous && at > previous && at - previous <= 10000) measuredMs += at - previous;
+    previous = at;
+    start = Math.min(start, at);
+    end = Math.max(end, at);
+  }
+  if (!count) return null;
+  const points = Array.from(minutes, ([at, bucket]) => ({ at, bpm: Math.round(bucket.total / bucket.count) }))
+    .sort((a, b) => a.at - b.at);
+  return { points, min, max, average: Math.round(total / count), count, start, end, measuredMs };
